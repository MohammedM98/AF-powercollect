# This file is the template for DEVELOPMENT. On the live server set at least:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://your-domain        (HTTPS only; the session cookie then becomes HTTPS-only too)
#   LOG_LEVEL=warning
#   SESSION_SECURE_COOKIE=true
#   INERTIA_DEVTOOLS_ENABLED=false
# and run `php artisan config:cache route:cache view:cache`. The scheduler (cron) and
# the queue worker must be running; see the Deployment section of README.md.
APP_NAME="AF Powercollect"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=powercollect
DB_USERNAME=powercollect
DB_PASSWORD=

SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=
BRANCH_MANAGER_NAME=Mohammed
BRANCH_MANAGER_USERNAME=mohammed
BRANCH_MANAGER_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Messages to subscribers: "log" only writes SMS to the log; "http" sends
# them through your provider's HTTP API (see config/services.php).
SMS_DRIVER=log
SMS_COUNTRY_CODE=970
SMS_HTTP_URL=
SMS_HTTP_METHOD=post
SMS_HTTP_TOKEN=
SMS_HTTP_TO_PARAM=to
SMS_HTTP_MESSAGE_PARAM=message
SMS_HTTP_SENDER_PARAM=sender
SMS_HTTP_SENDER=
# Fixed fields the provider needs, as a query string, e.g. api_key=XXXX&type=unicode
SMS_HTTP_EXTRA_PARAMS=
# Text the provider's reply must contain to count as sent (optional)
SMS_HTTP_SUCCESS_MATCH=
# "international" (970599…) or "local" (0599…)
SMS_HTTP_PHONE_FORMAT=international

VITE_APP_NAME="${APP_NAME}"

# Content-Security-Policy in production: "enforce" (default), "report-only" to try it
# without blocking anything, or "off".
# CSP_MODE=enforce

# The Inertia DevTools extension's request log: development only.
# INERTIA_DEVTOOLS_ENABLED=true

# Where collectors download the field app (shown on the dashboard of a field-only account).
# MOBILE_APP_URL=

# Nightly backup (backup:run): a filesystem disk that is NOT this server (an S3 bucket,
# say, defined in config/filesystems.php) where the copies are also sent, and how many
# days of backups to keep.
# BACKUP_DISK=s3
# BACKUP_KEEP_DAYS=14
