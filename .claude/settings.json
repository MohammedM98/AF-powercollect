{
    "hooks": {
        "SessionStart": [{
            "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/automation/hook.mjs\"", "timeout": 10 }]
        }],
        "PostToolUse": [{
            "matcher": "Edit|Write",
            "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/automation/hook.mjs\"", "timeout": 10 }]
        }],
        "Stop": [{
            "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/automation/hook.mjs\"", "timeout": 180 }]
        }]
    }
}
